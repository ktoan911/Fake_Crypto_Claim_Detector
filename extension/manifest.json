{
  "manifest_version": 3,
  "name": "Fake Crypto Claim Detector",
  "version": "1.0",
  "description": "Bôi đen nội dung (claim) để kiểm tra xem đúng hay sai.",
  "icons": {
    "16": "icon_extension.png",
    "32": "icon_extension.png",
    "48": "icon_extension.png",
    "128": "icon_extension.png"
  },
  "action": {
    "default_icon": {
      "16": "icon_extension.png",
      "32": "icon_extension.png",
      "48": "icon_extension.png",
      "128": "icon_extension.png"
    }
  },
  "permissions": [
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:7860/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}